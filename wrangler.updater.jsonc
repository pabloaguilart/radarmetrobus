{
    "name": "radarmetrobus-updater",
    "main": "./updater.mjs",
    "compatibility_date": "2026-11-13",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": false,
    "preview_urls": false,
    "build": { "command": "npm run build:cloudflare" },
    "triggers": { "crons": ["* * * * *"] },
    "durable_objects": {
        "bindings": [{ "name": "RADAR", "class_name": "RadarUpdater" }]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RadarUpdater"] }],
    "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "radarmetrobus-positions" }]
}
