{
    "name": "radarmetrobus",
    "compatibility_date": "2026-11-13",
    "main": "./updater.mjs",
    "compatibility_flags": ["nodejs_compat"],
    "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/vehicles.json"] },
    "build": { "command": "npm run build:cloudflare" },
    "triggers": { "crons": ["* * * * *"] },
    "durable_objects": {
        "bindings": [{ "name": "RADAR", "class_name": "RadarUpdater" }]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RadarUpdater"] }]
}
